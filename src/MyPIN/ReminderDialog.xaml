<Window x:Class="MyPIN.ReminderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lembrete" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Topmost="True"
        FontFamily="Segoe UI" FontSize="13" Background="#FAFAFB">
    <StackPanel Margin="18" Width="340">
        <TextBlock Text="Avisar sobre esta nota:" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" />

        <WrapPanel Margin="0,0,0,8">
            <Button Style="{StaticResource FlatButton}" Margin="0,0,6,6" Content="Em 15 min" Tag="m15" Click="Quick_Click" />
            <Button Style="{StaticResource FlatButton}" Margin="0,0,6,6" Content="Em 1 hora" Tag="h1" Click="Quick_Click" />
            <Button Style="{StaticResource FlatButton}" Margin="0,0,6,6" Content="Em 3 horas" Tag="h3" Click="Quick_Click" />
            <Button Style="{StaticResource FlatButton}" Margin="0,0,6,6" Content="Hoje 18:00" Tag="today18" Click="Quick_Click" />
            <Button Style="{StaticResource FlatButton}" Margin="0,0,6,6" Content="Amanhã 09:00" Tag="tomorrow9" Click="Quick_Click" />
            <Button Style="{StaticResource FlatButton}" Margin="0,0,6,6" Content="Segunda 09:00" Tag="monday9" Click="Quick_Click" />
        </WrapPanel>

        <TextBlock Text="Ou escolha data e hora:" Foreground="#555" Margin="0,4,0,6" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <DatePicker x:Name="DateBox" SelectedDateFormat="Short" />
            <TextBox x:Name="TimeBox" Grid.Column="2" VerticalContentAlignment="Center" Padding="4,3"
                     ToolTip="Ex.: 14:30, 9h, 0815" />
        </Grid>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="8" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Text="Repetir" VerticalAlignment="Center" Foreground="#555" />
            <ComboBox x:Name="RepeatBox" Grid.Column="1" Grid.ColumnSpan="2" Padding="6,4" />
            <TextBlock Grid.Row="2" Text="Som" VerticalAlignment="Center" Foreground="#555" />
            <ComboBox x:Name="SoundBox" Grid.Row="2" Grid.Column="1" Padding="6,4" />
            <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource FlatButton}" Margin="6,0,0,0" Padding="10,4"
                    Content="▶" ToolTip="Ouvir" Click="Preview_Click" />
        </Grid>

        <TextBlock x:Name="ErrorText" Foreground="#B91C1C" Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap" />

        <DockPanel Margin="0,18,0,0" LastChildFill="False">
            <Button x:Name="RemoveButton" DockPanel.Dock="Left" Style="{StaticResource DangerButton}" Content="Remover lembrete" Click="Remove_Click" />
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Margin="0" Content="OK" IsDefault="True" Click="Ok_Click" MinWidth="70" />
            <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Cancelar" IsCancel="True" />
        </DockPanel>
    </StackPanel>
</Window>
