<Window x:Class="MyPIN.AiSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyPIN — Inteligência Artificial" SizeToContent="Height" Width="520" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="#FAFAFB" FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="20">
        <DockPanel Margin="0,0,0,14">
            <TextBlock Text="✨" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center" />
            <StackPanel>
                <TextBlock Text="IA nas notas" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="Escolha o serviço de IA. O texto de uma nota só é enviado quando você usa o botão ✨ nela."
                           Foreground="#666" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <CheckBox x:Name="EnabledBox" Content="Mostrar o botão de IA (✨) nas notas" FontWeight="SemiBold" Margin="0,0,0,14" />

        <TextBlock Text="Serviço" FontWeight="SemiBold" Margin="0,0,0,4" />
        <ComboBox x:Name="ProviderBox" DisplayMemberPath="Name" Padding="6,5" SelectionChanged="ProviderBox_SelectionChanged" />
        <Border Background="#EEF2FF" CornerRadius="6" Padding="10,8" Margin="0,8,0,0">
            <TextBlock x:Name="HelpText" TextWrapping="Wrap" Foreground="#3730A3" FontSize="12" />
        </Border>

        <TextBlock Text="Endereço da API" FontWeight="SemiBold" Margin="0,14,0,4" />
        <TextBox x:Name="UrlBox" Padding="6,5" />

        <TextBlock x:Name="KeyLabel" Text="Chave da API" FontWeight="SemiBold" Margin="0,14,0,4" />
        <Grid x:Name="KeyRow">
            <PasswordBox x:Name="KeyBox" Padding="6,5" />
            <TextBlock x:Name="KeyHint" Text="•••• chave salva (deixe em branco para manter)" Foreground="#999"
                       Margin="8,0" VerticalAlignment="Center" IsHitTestVisible="False" />
        </Grid>

        <TextBlock Text="Modelo" FontWeight="SemiBold" Margin="0,14,0,4" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Margin="8,0,0,0" Content="Buscar modelos"
                    Click="ListModels_Click" />
            <ComboBox x:Name="ModelBox" IsEditable="True" Padding="6,5" />
        </DockPanel>

        <Border x:Name="StatusBorder" CornerRadius="6" Padding="10,8" Margin="0,14,0,0" Visibility="Collapsed">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
        </Border>

        <DockPanel Margin="0,20,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Style="{StaticResource FlatButton}" Content="Testar conexão" Click="Test_Click" />
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Margin="0" Content="Salvar" MinWidth="80"
                    IsDefault="True" Click="Save_Click" />
            <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Cancelar" IsCancel="True" />
        </DockPanel>
    </StackPanel>
</Window>
