<Window x:Class="MyPIN.NotebookDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Caderno" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Topmost="True"
        FontFamily="Segoe UI" FontSize="13" Background="#FAFAFB">
    <StackPanel Margin="18" Width="330">
        <TextBlock Text="Nome do caderno:" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBox x:Name="NameBox" Padding="6,5" MaxLength="40" />

        <TextBlock Text="Cor das notas novas deste caderno:" FontWeight="SemiBold" Margin="0,16,0,8" />
        <WrapPanel x:Name="ColorPanel" />

        <TextBlock x:Name="ErrorText" Foreground="#B91C1C" Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource FlatButton}" Content="Cancelar" IsCancel="True" />
            <Button Style="{StaticResource PrimaryButton}" Margin="0" Content="Salvar" IsDefault="True" MinWidth="80" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
