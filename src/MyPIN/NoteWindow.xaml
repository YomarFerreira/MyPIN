<Window x:Class="MyPIN.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nota" WindowStyle="None" AllowsTransparency="True" Background="#01000000"
        ShowInTaskbar="False" ResizeMode="CanResize"
        MinWidth="230" MinHeight="50" Width="296" Height="276"
        FontFamily="Segoe UI" UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewMouseDown="Window_PreviewMouseDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="8" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- Margem de 8px para a sombra; essa área também serve para redimensionar -->
    <Grid Margin="8">
        <Border CornerRadius="6" Background="White">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.28" />
            </Border.Effect>
        </Border>

        <Border x:Name="Root" CornerRadius="6" BorderThickness="1" BorderBrush="#22000000">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Cabeçalho -->
                <Border x:Name="Header" CornerRadius="5,5,0,0"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown"
                        MouseRightButtonUp="Header_MouseRightButtonUp"
                        ToolTip="Arraste para mover · duplo clique para dar um título · botão direito para opções"
                        ToolTipService.InitialShowDelay="1500">
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE710;" AutomationProperties.Name="Nova nota"
                                ToolTip="Nova nota (Ctrl+N)" Click="New_Click" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="AiButton" AutomationProperties.Name="IA" Style="{StaticResource IconButton}"
                                    Visibility="Collapsed" Click="AiButton_Click" ToolTip="Conversar com a IA sobre esta nota (Ctrl+Shift+I)">
                                <!-- brilhos (✨) desenhados em vetor -->
                                <Viewbox Width="15" Height="15">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="M 10,2 C 10.7,7.6 12.4,9.3 18,10 C 12.4,10.7 10.7,12.4 10,18 C 9.3,12.4 7.6,10.7 2,10 C 7.6,9.3 9.3,7.6 10,2 Z
                                                    M 18.5,14 C 18.8,16.6 19.4,17.2 22,17.5 C 19.4,17.8 18.8,18.4 18.5,21 C 18.2,18.4 17.6,17.8 15,17.5 C 17.6,17.2 18.2,16.6 18.5,14 Z" />
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Button x:Name="ReminderButton" AutomationProperties.Name="Lembrete" Style="{StaticResource IconButton}" Content="&#xE823;"
                                    Visibility="Collapsed" Click="Reminder_Click" />
                            <Button x:Name="LockButton" AutomationProperties.Name="Desbloquear" Style="{StaticResource IconButton}" Content="&#xE72E;"
                                    Visibility="Collapsed" Click="Lock_Click"
                                    ToolTip="Nota bloqueada (clique para desbloquear)" />
                            <Button x:Name="PinButton" AutomationProperties.Name="Fixar" Style="{StaticResource IconButton}" Click="Pin_Click">
                                <!-- Pino desenhado em vetor (24×24): em pé = fixado; inclinado = solto -->
                                <Viewbox Width="17" Height="17">
                                    <Canvas Width="24" Height="24">
                                        <Path x:Name="PinShape" StrokeThickness="0.9" StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="M 8.6,2.4 H 15.4 A 1.3,1.3 0 0 1 15.4,5 H 8.6 A 1.3,1.3 0 0 1 8.6,2.4 Z
                                                    M 10,5 L 9.6,10.6 L 6.8,13.8 H 17.2 L 14.4,10.6 L 14,5 Z
                                                    M 12,13.8 V 21.6">
                                            <Path.RenderTransform>
                                                <TransformGroup>
                                                    <RotateTransform x:Name="PinRotate" CenterX="12" CenterY="12" Angle="40" />
                                                    <TranslateTransform x:Name="PinShift" />
                                                </TransformGroup>
                                            </Path.RenderTransform>
                                        </Path>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                            <Button x:Name="MenuButton" AutomationProperties.Name="Opções" Style="{StaticResource IconButton}" Content="&#xE712;"
                                    ToolTip="Opções" Click="Menu_Click" />
                            <Button x:Name="RollButton" AutomationProperties.Name="Recolher" Style="{StaticResource IconButton}" Click="Roll_Click" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE711;" AutomationProperties.Name="Ocultar" Click="Close_Click"
                                    ToolTip="Ocultar nota (Ctrl+W)&#x0a;Reabra pelo ícone perto do relógio" />
                        </StackPanel>
                        <Grid Margin="2,0">
                            <TextBlock x:Name="TitleText" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"
                                       TextTrimming="CharacterEllipsis" Foreground="#D9000000" />
                            <TextBox x:Name="TitleBox" Visibility="Collapsed" VerticalAlignment="Center"
                                     FontWeight="SemiBold" FontSize="13" Background="#55FFFFFF" BorderThickness="0"
                                     Padding="2,1" MaxLength="80"
                                     KeyDown="TitleBox_KeyDown" LostKeyboardFocus="TitleBox_LostKeyboardFocus" />
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Barra do lembrete (aparece quando o lembrete toca) -->
                <Border x:Name="ReminderBar" Grid.Row="1" Visibility="Collapsed" Background="#14000000" Padding="6,4">
                    <Border.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                            <Setter Property="Padding" Value="8,2" />
                            <Setter Property="Margin" Value="0,0,4,0" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="Background" Value="#C8FFFFFF" />
                            <Setter Property="BorderBrush" Value="#33000000" />
                        </Style>
                    </Border.Resources>
                    <StackPanel>
                        <TextBlock x:Name="ReminderBarText" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"
                                   TextTrimming="CharacterEllipsis" Foreground="#D9000000" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" x:Name="SnoozeOk" AutomationProperties.Name="Ok, visto" Content="Ok"
                                    Margin="0" Click="SnoozeOk_Click" ToolTip="Fechar o aviso" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Adiar:" VerticalAlignment="Center" FontSize="12" Margin="0,0,4,0" Foreground="#B0000000" />
                                <Button Content="5 min" Tag="5" Click="Snooze_Click" />
                                <Button Content="15 min" Tag="15" Click="Snooze_Click" />
                                <Button Content="1 hora" Tag="60" Click="Snooze_Click" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Barra de Localizar (Ctrl+F) -->
                <Border x:Name="FindBar" Grid.Row="2" Visibility="Collapsed" Background="#14000000" Padding="6,4">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolIconButton}" Content="&#xE711;"
                                ToolTip="Fechar (Esc)" Click="FindClose_Click" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolIconButton}" Content="&#xE70D;"
                                ToolTip="Próximo (Enter)" Click="FindNext_Click" AutomationProperties.Name="Próximo" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolIconButton}" Content="&#xE70E;"
                                ToolTip="Anterior (Shift+Enter)" Click="FindPrev_Click" AutomationProperties.Name="Anterior" />
                        <TextBlock x:Name="FindCount" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11"
                                   Foreground="#99000000" Margin="6,0" />
                        <Grid>
                            <TextBox x:Name="FindBox" Padding="3,2" BorderBrush="#33000000" Background="#AAFFFFFF"
                                     VerticalContentAlignment="Center"
                                     TextChanged="FindBox_TextChanged" PreviewKeyDown="FindBox_PreviewKeyDown" />
                            <TextBlock x:Name="FindHint" Text="Localizar na nota..." Foreground="#80000000" FontSize="12"
                                       Margin="6,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Texto -->
                <RichTextBox x:Name="Editor" Grid.Row="3" Background="Transparent" BorderThickness="0"
                             Padding="6" AcceptsTab="True" FontSize="14" Foreground="#222222"
                             FocusVisualStyle="{x:Null}" VerticalScrollBarVisibility="Auto"
                             IsInactiveSelectionHighlightEnabled="True"
                             SpellCheck.IsEnabled="True" xml:lang="pt-BR"
                             TextChanged="Editor_TextChanged" ContextMenuOpening="Editor_ContextMenuOpening"
                             PreviewMouseWheel="Editor_PreviewMouseWheel">
                    <RichTextBox.LayoutTransform>
                        <ScaleTransform x:Name="ZoomTransform" />
                    </RichTextBox.LayoutTransform>
                    <RichTextBox.Resources>
                        <Style TargetType="Paragraph">
                            <Setter Property="Margin" Value="0" />
                        </Style>
                        <Style TargetType="List">
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Padding" Value="20,0,0,0" />
                        </Style>
                    </RichTextBox.Resources>
                    <FlowDocument PagePadding="0" />
                </RichTextBox>

                <!-- Localizar: realça todas as ocorrências e, mais forte, a atual (desenho por cima, não altera o texto) -->
                <Canvas x:Name="FindOverlay" Grid.Row="3" ClipToBounds="True" IsHitTestVisible="False" />

                <!-- Botões "+" das tabelas (por cima do texto; o fundo vazio deixa os cliques passarem) -->
                <Canvas x:Name="TableOverlay" Grid.Row="3" ClipToBounds="True">
                    <Canvas.Resources>
                        <Style x:Key="PlusButton" TargetType="Button">
                            <Setter Property="Width" Value="18" />
                            <Setter Property="Height" Value="18" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <!-- cinza, no tom das linhas da tabela -->
                                            <Ellipse x:Name="Bg" Fill="#70000000" Opacity="0.75" />
                                            <TextBlock Text="{TemplateBinding Content}" FontFamily="{StaticResource IconFont}" FontSize="9"
                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Opacity" Value="1" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style x:Key="TableTool" TargetType="Button">
                            <Setter Property="Width" Value="18" />
                            <Setter Property="Height" Value="14" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg" Background="Transparent" CornerRadius="3">
                                            <TextBlock x:Name="Glyph" Text="{TemplateBinding Content}" FontFamily="{StaticResource IconFont}"
                                                       FontSize="9" Foreground="#73000000"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="#14000000" />
                                                <Setter TargetName="Glyph" Property="Foreground" Value="#E6000000" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Canvas.Resources>
                    <Button x:Name="AddRowButton" Style="{StaticResource PlusButton}" Content="&#xE710;"
                            ToolTip="Adicionar linha no fim da tabela" AutomationProperties.Name="Adicionar linha" />
                    <Button x:Name="AddColButton" Style="{StaticResource PlusButton}" Content="&#xE710;"
                            ToolTip="Adicionar coluna no fim da tabela" AutomationProperties.Name="Adicionar coluna" />
                    <!-- acima da tabela, no canto direito: ícones finos, sem fundo, mais escuros com o mouse -->
                    <Button x:Name="TableMinButton" Style="{StaticResource TableTool}" Content="&#xE921;"
                            ToolTip="Minimizar a tabela (fica só a 1ª linha)" AutomationProperties.Name="Minimizar tabela" />
                    <Button x:Name="TableCloseButton" Style="{StaticResource TableTool}" Content="&#xE8BB;"
                            ToolTip="Excluir a tabela" AutomationProperties.Name="Excluir tabela" />
                    <Button x:Name="TableRestoreButton" Style="{StaticResource TableTool}" Content="&#xE922;"
                            ToolTip="Restaurar a tabela inteira" AutomationProperties.Name="Restaurar tabela" />

                    <!-- confirmação de excluir: faixa baixa logo acima da tabela -->
                    <Border x:Name="TableConfirmBar" Visibility="Collapsed" Background="#F2FFFFFF" BorderBrush="#40000000"
                            BorderThickness="1" CornerRadius="4" Padding="8,2,3,2">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.18" />
                        </Border.Effect>
                        <Border.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                <Setter Property="Padding" Value="8,1" />
                                <Setter Property="Margin" Value="4,0,0,0" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="Focusable" Value="False" />
                            </Style>
                        </Border.Resources>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Excluir esta tabela?" FontSize="12" VerticalAlignment="Center" Foreground="#D9000000" />
                            <Button x:Name="TableConfirmYes" Content="Confirmar" Foreground="#B91C1C" Margin="10,0,0,0"
                                    ToolTip="Excluir a tabela (Ctrl+Z desfaz). Clique fora para cancelar." AutomationProperties.Name="Confirmar excluir tabela" />
                        </StackPanel>
                    </Border>
                </Canvas>

                <!-- Painel de IA (botão ✨) -->
                <Border x:Name="AiPanel" Grid.Row="4" Visibility="Collapsed" Height="260" Background="#12000000"
                        BorderBrush="#1F000000" BorderThickness="0,1,0,0">
                    <DockPanel Margin="6,3,6,6">
                        <DockPanel DockPanel.Dock="Top">
                            <Button DockPanel.Dock="Right" Style="{StaticResource ToolIconButton}" Content="&#xE711;"
                                    ToolTip="Fechar a IA (Ctrl+Shift+I)" Click="AiClose_Click" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource ToolIconButton}" Content="&#xE72C;"
                                    ToolTip="Nova conversa (esquece o que foi dito)" Click="AiReset_Click" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource ToolIconButton}" Content="&#xE713;"
                                    ToolTip="Configurar a IA" Click="AiSettings_Click" />
                            <TextBlock x:Name="AiTitle" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Foreground="#CC000000" />
                        </DockPanel>
                        <WrapPanel x:Name="AiQuick" DockPanel.Dock="Top" Margin="0,2,0,2" />
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                            <Button x:Name="AiSendButton" DockPanel.Dock="Right" Style="{StaticResource ToolIconButton}"
                                    Content="&#xE724;" ToolTip="Enviar (Enter)" Click="AiSend_Click" VerticalAlignment="Bottom" />
                            <Grid>
                                <TextBox x:Name="AiInput" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="64"
                                         VerticalScrollBarVisibility="Auto" Padding="4,3" Background="#C8FFFFFF"
                                         BorderBrush="#33000000" FontSize="12.5"
                                         PreviewKeyDown="AiInput_PreviewKeyDown" TextChanged="AiInput_TextChanged" />
                                <TextBlock x:Name="AiHint" Text="Pergunte ou peça algo sobre esta nota..." Foreground="#80000000"
                                           FontSize="12" Margin="7,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Grid>
                        </DockPanel>
                        <ScrollViewer x:Name="AiScroll" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="AiConversation" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Barra de formatação (aparece quando a nota está em foco) -->
                <Border x:Name="Footer" Grid.Row="5" Visibility="Collapsed" BorderThickness="0,1,0,0"
                        BorderBrush="#14000000" Padding="4,2">
                    <DockPanel>
                        <!-- data/hora: sempre no canto inferior direito, separada dos botões -->
                        <TextBlock x:Name="InfoText" DockPanel.Dock="Right" VerticalAlignment="Bottom" FontSize="11"
                                   Foreground="#80000000" Margin="10,0,2,4" />
                    <!-- WrapPanel: em nota estreita os botões quebram para uma segunda linha -->
                    <WrapPanel x:Name="FooterButtons">
                            <Button x:Name="FooterMenuButton" Style="{StaticResource ToolIconButton}" Content="&#xE700;"
                                    ToolTip="Menu da nota (o mesmo do ⋯ lá em cima)" Click="FooterMenu_Click" Tag="menu"
                                    AutomationProperties.Name="Menu da nota" />
                            <Button Style="{StaticResource ToolIconButton}" Content="&#xE7A7;" ToolTip="Desfazer (Ctrl+Z)" Click="Undo_Click" Tag="undo"
                                    AutomationProperties.Name="Desfazer" />
                            <Button Style="{StaticResource ToolIconButton}" Content="&#xE7A6;" ToolTip="Refazer (Ctrl+Y)" Click="Redo_Click" Tag="redo"
                                    AutomationProperties.Name="Refazer" />
                            <Button Style="{StaticResource ToolButton}" ToolTip="Diminuir a letra (Ctrl+Shift+&lt;)" Click="FontSmaller_Click" Tag="size"
                                    AutomationProperties.Name="Diminuir letra">
                                <TextBlock><Run Text="A" FontSize="10" /><Run Text="−" FontSize="9" /></TextBlock>
                            </Button>
                            <Button Style="{StaticResource ToolButton}" ToolTip="Aumentar a letra (Ctrl+Shift+&gt;)" Click="FontBigger_Click" Tag="size"
                                    AutomationProperties.Name="Aumentar letra">
                                <TextBlock><Run Text="A" FontSize="14" /><Run Text="+" FontSize="10" /></TextBlock>
                            </Button>
                            <Button x:Name="FontFamilyButton" Style="{StaticResource ToolButton}" ToolTip="Tipo de letra" Click="FontFamily_Click" Tag="font"
                                    AutomationProperties.Name="Tipo de letra">
                                <TextBlock Text="Aa" FontFamily="Times New Roman" FontSize="13" />
                            </Button>
                            <Button Style="{StaticResource ToolButton}" ToolTip="Negrito (Ctrl+B)" Click="Bold_Click" Tag="bold">
                                <TextBlock Text="B" FontWeight="Bold" />
                            </Button>
                            <Button Style="{StaticResource ToolButton}" ToolTip="Itálico (Ctrl+I)" Click="Italic_Click" Tag="italic">
                                <TextBlock Text="I" FontStyle="Italic" FontFamily="Georgia" />
                            </Button>
                            <Button Style="{StaticResource ToolButton}" ToolTip="Sublinhado (Ctrl+U)" Click="Underline_Click" Tag="underline">
                                <TextBlock Text="U" TextDecorations="Underline" />
                            </Button>
                            <Button Style="{StaticResource ToolButton}" ToolTip="Tachado (Ctrl+T)" Click="Strike_Click" Tag="strike">
                                <TextBlock Text="S" TextDecorations="Strikethrough" />
                            </Button>
                            <Button x:Name="HighlightButton" Style="{StaticResource ToolIconButton}" Content="&#xE7E6;" ToolTip="Marca-texto: escolher a cor (Ctrl+H)" Click="Highlight_Click" Tag="highlight" AutomationProperties.Name="Marca-texto" />
                            <Button Style="{StaticResource ToolIconButton}" Content="&#xE8FD;" ToolTip="Lista com marcadores (Ctrl+Shift+L)" Click="Bullets_Click" Tag="bullets" />
                            <Button Style="{StaticResource ToolIconButton}" Content="&#xE73A;" ToolTip="Inserir caixa de tarefa ☐ (Ctrl+Shift+C)&#x0a;Clique na caixa para marcar ☑" Click="Checkbox_Click" Tag="checkbox" />
                            <Button x:Name="TableButton" Style="{StaticResource ToolIconButton}" Click="Table_Click" Tag="table"
                                    AutomationProperties.Name="Tabela"
                                    ToolTip="Inserir tabela&#x0a;Botão direito numa célula: linhas, colunas e mesclar&#x0a;Também dá para colar células do Excel">
                                <!-- ícone de grade desenhado em vetor -->
                                <Viewbox Width="13" Height="13">
                                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3"
                                          Data="M 0.5,0.5 H 15.5 V 15.5 H 0.5 Z M 0.5,5.5 H 15.5 M 0.5,10.5 H 15.5 M 5.5,0.5 V 15.5 M 10.5,0.5 V 15.5" />
                                </Viewbox>
                            </Button>
                            <Button x:Name="DividerButton" Style="{StaticResource ToolIconButton}" Click="Divider_Click" Tag="divider"
                                    AutomationProperties.Name="Linha divisória"
                                    ToolTip="Inserir linha divisória&#x0a;Atalhos: --- ou ___ (fina), === (dupla), *** (pontilhada) + Enter">
                                <Viewbox Width="14" Height="14">
                                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3"
                                          Data="M 0,8 H 16 M 0,3 H 9 M 0,13 H 11" Opacity="1" />
                                </Viewbox>
                            </Button>
                    </WrapPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
