<Window x:Class="MyPIN.ReminderSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyPIN — Lembretes" SizeToContent="Height" Width="460" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="#FAFAFB" FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="20">
        <TextBlock Text="⏰ Lembretes" FontSize="17" FontWeight="SemiBold" />
        <TextBlock Text="Quando um lembrete dispara, a nota vem para a frente e pisca, e o som repete até você clicar nela (no máximo 1 minuto)."
                   Foreground="#666" TextWrapping="Wrap" Margin="0,4,0,16" />

        <TextBlock Text="Som padrão" FontWeight="SemiBold" Margin="0,0,0,4" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Margin="6,0,0,0" Padding="10,4"
                    Content="▶" ToolTip="Ouvir" Click="Preview_Click" />
            <ComboBox x:Name="SoundBox" Padding="6,4" />
        </DockPanel>
        <TextBlock Text="Cada lembrete também pode ter um som próprio (na janela do lembrete)."
                   Foreground="#888" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />

        <!-- Som do usuário -->
        <Border Background="White" BorderBrush="#E2E2E6" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="★ Meu som" FontWeight="SemiBold" />
                <TextBlock x:Name="UserSoundText" Foreground="#555" Margin="0,2,0,8" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource FlatButton}" Content="Escolher arquivo..." Click="ChooseUser_Click" />
                    <Button x:Name="RemoveUserButton" Style="{StaticResource DangerButton}" Content="Remover" Click="RemoveUser_Click" />
                </StackPanel>
                <TextBlock x:Name="RulesText" Foreground="#888" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <DockPanel Margin="0,18,0,4">
            <TextBlock x:Name="VolumeText" DockPanel.Dock="Right" Foreground="#555" />
            <TextBlock Text="Volume" FontWeight="SemiBold" />
        </DockPanel>
        <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" ValueChanged="VolumeSlider_ValueChanged" />

        <DockPanel Margin="0,20,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Margin="0" Content="Salvar" MinWidth="80"
                    IsDefault="True" Click="Save_Click" />
            <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="Cancelar" IsCancel="True" />
        </DockPanel>
    </StackPanel>
</Window>
